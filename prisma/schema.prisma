generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String  @id @default(uuid())
  nom         String  @unique
  description String?

  utilisateurs Utilisateur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Utilisateur {
  id        String  @id @default(uuid())
  nom       String
  prenom    String
  email     String  @unique
  telephone String?
  login     String  @unique
  password  String
  statut    Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  demandes Demande[]

  historiqueStatuts   HistoriqueStatutDemande[]
  documentsTeleverses DemandeDocument[]
  journauxCloture     JournalCloture[]
  paiementsEncaisses  Paiement[]

  // Journaux appartenant au Caissier.
  journauxCaisse JournalCaisse[] @relation("JournalCaisseCaissier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatutDemande {
  EN_ATTENTE
  EN_COURS
  VALIDEE
  REJETEE
}

enum TypeDocument {
  CIN
  PASSEPORT
  CONTRAT
  PROCURATION
}

enum StatutDocument {
  DEPOSE
  CONFORME
  NON_CONFORME
}

enum StatutVerificationCni {
  NON_VERIFIEE
  VERIFIEE
  ECHEC
  INDISPONIBLE
}

enum LangueCertificat {
  FRANCAIS
  ARABE
  ANGLAIS
}

enum ModePaiement {
  ESPECES
}

enum StatutPaiement {
  PAYE
  REMBOURSE
}

enum StatutJournalCaisse {
  OUVERT
  CLOTURE
}

model Demande {
  id     String @id @default(uuid())
  numero String @unique

  // Informations du demandeur.
  nomDemandeur    String
  prenomDemandeur String
  cin             String
  telephone       String
  email           String?

  // Informations retournées par le service CNI.
  dateNaissanceDemandeur DateTime? @db.Date
  adresseDemandeur       String?

  // Traçabilité de la vérification CNI.
  statutVerificationCni    StatutVerificationCni @default(NON_VERIFIEE)
  dateVerificationCni      DateTime?
  sourceVerificationCni    String?
  referenceVerificationCni String?
  messageVerificationCni   String?

  // Paramètres et tarification du certificat.
  nombreExemplaires  Int              @default(1)
  langueCertificat   LangueCertificat @default(FRANCAIS)
  traductionDemandee Boolean          @default(false)

  prixUnitaire         Decimal @default(30.000) @db.Decimal(10, 3)
  supplementTraduction Decimal @default(0.000) @db.Decimal(10, 3)
  montantTotal         Decimal @default(30.000) @db.Decimal(10, 3)

  // Informations foncières.
  referenceFonciere String
  adresseBien       String

  // Cycle de traitement.
  statut       StatutDemande @default(EN_ATTENTE)
  observations String?
  motifRejet   String?

  // Journal de clôture des demandes.
  journalClotureId String?
  journalCloture   JournalCloture? @relation(fields: [journalClotureId], references: [id])

  // Agent ayant créé la demande.
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  historiqueStatuts   HistoriqueStatutDemande[]
  documentsTeleverses DemandeDocument[]
  paiement            Paiement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cin, referenceFonciere])
  @@index([journalClotureId])
  @@index([cin])
  @@index([statutVerificationCni])
}

model HistoriqueStatutDemande {
  id            String        @id @default(uuid())
  ancienStatut  StatutDemande
  nouveauStatut StatutDemande
  motif         String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  createdAt DateTime @default(now())

  @@index([demandeId])
  @@index([utilisateurId])
}

model DemandeDocument {
  id String @id @default(uuid())

  type TypeDocument

  nomOriginal   String
  nomStockage   String @unique
  cheminFichier String
  mimeType      String
  taille        Int

  statut             StatutDocument @default(DEPOSE)
  motifNonConformite String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandeId, type])
  @@index([demandeId])
  @@index([utilisateurId])
}

model JournalCloture {
  id     String @id @default(uuid())
  numero String @unique

  dateJour    DateTime @unique @db.Date
  dateCloture DateTime @default(now())

  observations String?

  responsableId String
  responsable   Utilisateur @relation(fields: [responsableId], references: [id])

  demandes Demande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsableId])
}

model JournalCaisse {
  id     String @id @default(uuid())
  numero String @unique

  // Journée de travail concernée.
  dateJour DateTime @db.Date

  // Le journal reste ouvert pendant les encaissements.
  statut StatutJournalCaisse @default(OUVERT)

  // Renseignée au moment de la clôture.
  dateCloture DateTime?

  observations String?

  // Caissier propriétaire du journal.
  caissierId String
  caissier   Utilisateur @relation("JournalCaisseCaissier", fields: [caissierId], references: [id], onDelete: Restrict)

  // Paiements enregistrés dans ce journal.
  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un seul journal par Caissier et par journée.
  @@unique([caissierId, dateJour])
  @@index([caissierId])
  @@index([dateJour])
  @@index([statut])
}

model Paiement {
  id         String @id @default(uuid())
  numeroRecu String @unique

  // Montant calculé par le backend.
  montantExigible Decimal @db.Decimal(10, 3)

  // Somme remise par le citoyen.
  montantRemis Decimal @db.Decimal(10, 3)

  // Monnaie rendue au citoyen.
  monnaieRendue Decimal @default(0.000) @db.Decimal(10, 3)

  // Montant conservé par la caisse.
  montantEncaisse Decimal @db.Decimal(10, 3)

  modePaiement ModePaiement   @default(ESPECES)
  statut       StatutPaiement @default(PAYE)

  montantEnLettres String?
  observations     String?

  datePaiement DateTime @default(now())

  // Une demande ne peut avoir qu’un paiement.
  demandeId String  @unique
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Restrict)

  // Utilisateur ayant réalisé l’encaissement.
  caissierId String
  caissier   Utilisateur @relation(fields: [caissierId], references: [id], onDelete: Restrict)

  // Journal de caisse auquel appartient le paiement.
  // Facultatif pour conserver les anciens paiements.
  journalCaisseId String?
  journalCaisse   JournalCaisse? @relation(fields: [journalCaisseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caissierId])
  @@index([journalCaisseId])
  @@index([datePaiement])
}
