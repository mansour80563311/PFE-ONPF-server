generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// UTILISATEURS ET ROLES
// ============================================================

model Role {
  id          String  @id @default(uuid())
  nom         String  @unique
  description String?

  utilisateurs Utilisateur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Utilisateur {
  id        String  @id @default(uuid())
  nom       String
  prenom    String
  email     String  @unique
  telephone String?
  login     String  @unique
  password  String
  statut    Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  demandes Demande[]

  historiqueStatuts         HistoriqueStatutDemande[]
  documentsTeleverses       DemandeDocument[]
  journauxCloture           JournalCloture[]
  evenementsJournauxCloture JournalClotureEvenement[] @relation("JournalClotureEvenementAuteur")
  paiementsEncaisses        Paiement[]

  // Corrections effectuées par le Responsable Guichet.
  revisionsDemandes RevisionDemande[] @relation("RevisionDemandeResponsable")

  // Compléments encaissés par le caissier.
  paiementsComplementairesEncaisses PaiementComplementaire[] @relation("PaiementComplementaireCaissier")

  journauxCaisse JournalCaisse[] @relation("JournalCaisseCaissier")

  // ========================================================
  // SERVICE D'ETUDE
  // ========================================================

  // Dossiers distribués par le Responsable des inscriptions.
  dossiersEtudeDistribues DossierEtude[] @relation("DossierEtudeDistribuePar")

  // Affectations reçues comme Rédacteur / Vérificateur / Super-vérificateur.
  affectationsEtudeRecues AffectationEtude[] @relation("AffectationEtudeUtilisateur")

  // Affectations / réaffectations décidées par le Responsable des inscriptions.
  affectationsEtudeAttribuees AffectationEtude[] @relation("AffectationEtudeAttribuePar")

  // Avis successifs émis pendant l'étude d'une opération.
  avisEtudeRediges AvisEtude[] @relation("AvisEtudeAuteur")

  // Versions de minutes rédigées ou modifiées.
  versionsMinuteRedigees VersionMinute[] @relation("VersionMinuteAuteur")

  // Retours pour correction émis pendant le circuit d'étude.
  retoursCorrectionEmis RetourCorrection[] @relation("RetourCorrectionAuteur")

  // Retours pour correction reçus pendant le circuit d'étude.
  retoursCorrectionRecus RetourCorrection[] @relation("RetourCorrectionDestinataire")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ENUMERATIONS EXISTANTES
// ============================================================

enum StatutDemande {
  EN_ATTENTE
  EN_COURS
  VALIDEE
  REJETEE
}

enum TypeDocument {
  CIN
  PASSEPORT
  CONTRAT
  PROCURATION
}

enum StatutDocument {
  DEPOSE
  CONFORME
  NON_CONFORME
}

enum StatutVerificationCni {
  NON_VERIFIEE
  VERIFIEE
  ECHEC
  INDISPONIBLE
}

enum LangueCertificat {
  FRANCAIS
  ARABE
  ANGLAIS
}

enum ModePaiement {
  ESPECES
}

enum StatutPaiement {
  PAYE
  REMBOURSE
}

enum StatutJournalCaisse {
  OUVERT
  CLOTURE
}

// Etat courant d'un journal de clôture du guichet.
// Une journée déclôturée reste historisée : le journal n'est jamais supprimé.
enum StatutJournalCloture {
  CLOTURE
  DECLOTUREE
}

// Historique des fermetures / réouvertures administratives du guichet.
enum TypeEvenementJournalCloture {
  CLOTURE
  DECLOTURE
}

// ============================================================
// ENUMERATIONS DU SERVICE D'ETUDE
// ============================================================

// Etat global du dossier dans le service d'étude.
// Le dossier n'est créé qu'au moment de sa distribution.
enum StatutDossierEtude {
  EN_ETUDE
  TERMINE
}

// Type d'affectation décidée par le Responsable des inscriptions.
enum TypeAffectationEtude {
  REDACTEUR
  VERIFICATEUR
  SUPER_VERIFICATEUR
}

// Etat de traitement d'une opération foncière au service d'étude.
enum StatutEtudeOperation {
  EN_REDACTION
  EN_VERIFICATION
  A_CORRIGER_REDACTEUR
  EN_SUPER_VERIFICATION
  A_CORRIGER_VERIFICATEUR
  FINALISEE
  CLOTUREE
}

// Niveau métier ayant émis un avis.
// Il est historisé indépendamment du rôle courant de l'utilisateur.
enum NiveauAvisEtude {
  REDACTEUR
  VERIFICATEUR
  SUPER_VERIFICATEUR
}

// Décision portée par un avis d'étude.
enum DecisionAvisEtude {
  INSCRIPTION
  REFUS
}

// Origine de préparation de la minute.
enum ModePreparationMinute {
  MODELE
  MANUEL
}

// ============================================================
// NOUVELLES ENUMERATIONS
// ============================================================

enum NatureDemande {
  INSCRIPTION
  PRESTATION
}

enum CategorieOperationFonciere {
  STANDARD
  DISTRACTION
}

enum StatutTarification {
  CALCULEE
  FIGEE
}

// Etat d'une révision effectuée par le Responsable Guichet.
enum StatutRevisionDemande {
  SANS_COMPLEMENT
  COMPLEMENT_A_PAYER
  COMPLEMENT_PAYE
}

enum TypeLigneTarification {
  ARCHIVAGE_DOSSIER
  ETUDE_OPERATION
  BASE_PRESTATION
  TARIFICATION_PAGE
  SUPPLEMENT_FRANCAIS
  AUTRE
}

// ============================================================
// GOUVERNORATS
// ============================================================

model Gouvernorat {
  id   String @id @default(uuid())
  code String @unique
  nom  String @unique

  actif Boolean @default(true)

  titresFonciers TitreFoncier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// TITRES FONCIERS
// ============================================================

model TitreFoncier {
  id String @id @default(uuid())

  // Le numéro seul n'est pas unique.
  numero String

  gouvernoratId String
  gouvernorat   Gouvernorat @relation(fields: [gouvernoratId], references: [id], onDelete: Restrict)

  // Plusieurs demandes peuvent concerner le même titre.
  demandes Demande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identification métier :
  // numéro du titre + gouvernorat.
  @@unique([numero, gouvernoratId])
  @@index([numero])
  @@index([gouvernoratId])
}

// ============================================================
// TYPES D'OPERATIONS FONCIERES
// ============================================================

model TypeOperationFonciere {
  id String @id @default(uuid())

  // Exemples :
  // VENTE
  // HYPOTHEQUE
  // DONATION
  // SUCCESSION
  // RADIATION
  // MAINLEVEE
  // ECHANGE
  // PARTAGE
  // DISTRACTION
  code String @unique

  libelle     String
  description String?

  categorie CategorieOperationFonciere

  actif Boolean @default(true)

  demandes DemandeOperationFonciere[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorie])
  @@index([actif])
}

// ============================================================
// OPERATIONS FONCIERES D'UNE DEMANDE
// ============================================================

model DemandeOperationFonciere {
  id String @id @default(uuid())

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  typeOperationFonciereId String
  typeOperationFonciere   TypeOperationFonciere @relation(fields: [typeOperationFonciereId], references: [id], onDelete: Restrict)

  // Une occurrence d'opération d'une demande possède au maximum
  // une seule étude dans le service d'étude.
  etudeOperation EtudeOperation?

  createdAt DateTime @default(now())

  @@unique([demandeId, typeOperationFonciereId])
  @@index([demandeId])
  @@index([typeOperationFonciereId])
}

// ============================================================
// TARIFS DES OPERATIONS FONCIERES
// ============================================================

model TarifOperationFonciere {
  id String @id @default(uuid())

  categorie CategorieOperationFonciere

  montantEtude Decimal @db.Decimal(10, 3)

  dateDebutValidite DateTime  @db.Date
  dateFinValidite   DateTime? @db.Date

  referenceReglementaire String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorie])
  @@index([categorie, dateDebutValidite])
}

// ============================================================
// TARIF GENERAL D'UNE INSCRIPTION
// ============================================================

model TarifInscription {
  id String @id @default(uuid())

  montantArchivage Decimal @db.Decimal(10, 3)

  dateDebutValidite DateTime  @db.Date
  dateFinValidite   DateTime? @db.Date

  referenceReglementaire String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dateDebutValidite])
}

// ============================================================
// PRESTATIONS
// ============================================================

model Prestation {
  id String @id @default(uuid())

  code String @unique

  libelle     String
  description String?

  // Indique si le nombre de pages intervient dans le calcul.
  tarificationParPage Boolean @default(false)

  // Indique si le supplément français est applicable.
  supplementFrancaisApplicable Boolean @default(false)

  // Certaines prestations peuvent ne pas nécessiter de titre.
  necessiteTitreFoncier Boolean @default(true)

  actif Boolean @default(true)

  tarifs   TarifPrestation[]
  demandes Demande[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif])
}

// ============================================================
// TARIFS DES PRESTATIONS
// ============================================================

model TarifPrestation {
  id String @id @default(uuid())

  prestationId String
  prestation   Prestation @relation(fields: [prestationId], references: [id], onDelete: Restrict)

  montantBase Decimal @default(0.000) @db.Decimal(10, 3)

  montantParPage Decimal @default(0.000) @db.Decimal(10, 3)

  supplementFrancais Decimal @default(0.000) @db.Decimal(10, 3)

  dateDebutValidite DateTime  @db.Date
  dateFinValidite   DateTime? @db.Date

  referenceReglementaire String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prestationId])
  @@index([prestationId, dateDebutValidite])
}

// ============================================================
// DEMANDES
// ============================================================

model Demande {
  id     String @id @default(uuid())
  numero String @unique

  // Informations du demandeur.
  nomDemandeur    String
  prenomDemandeur String
  cin             String
  telephone       String
  email           String?

  // Informations retournées par le service CNI.
  dateNaissanceDemandeur DateTime? @db.Date
  adresseDemandeur       String?

  // Vérification CNI.
  statutVerificationCni    StatutVerificationCni @default(NON_VERIFIEE)
  dateVerificationCni      DateTime?
  sourceVerificationCni    String?
  referenceVerificationCni String?
  messageVerificationCni   String?

  // ========================================================
  // ANCIENNE TARIFICATION
  // Conservée temporairement.
  // ========================================================

  nombreExemplaires  Int              @default(1)
  langueCertificat   LangueCertificat @default(FRANCAIS)
  traductionDemandee Boolean          @default(false)

  prixUnitaire         Decimal @default(30.000) @db.Decimal(10, 3)
  supplementTraduction Decimal @default(0.000) @db.Decimal(10, 3)
  montantTotal         Decimal @default(30.000) @db.Decimal(10, 3)

  // ========================================================
  // ANCIENNES INFORMATIONS FONCIERES
  // Conservées temporairement.
  // ========================================================

  referenceFonciere String
  adresseBien       String

  // ========================================================
  // NOUVELLE STRUCTURE METIER
  // ========================================================

  nature NatureDemande?

  titreFoncierId String?
  titreFoncier   TitreFoncier? @relation(fields: [titreFoncierId], references: [id], onDelete: Restrict)

  // Utilisé pour les demandes de type PRESTATION.
  prestationId String?
  prestation   Prestation? @relation(fields: [prestationId], references: [id], onDelete: Restrict)

  // Utilisé seulement si la prestation est tarifée par page.
  nombrePages Int?

  // Une demande peut contenir plusieurs opérations foncières.
  operationsFoncieres DemandeOperationFonciere[]

  // Nouveau calcul tarifaire détaillé.
  tarification TarificationDemande?

  // Cycle de traitement.
  statut       StatutDemande @default(EN_ATTENTE)
  observations String?
  motifRejet   String?

  // Journal de clôture.
  journalClotureId String?
  journalCloture   JournalCloture? @relation(fields: [journalClotureId], references: [id])

  // Agent ayant créé la demande.
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  historiqueStatuts   HistoriqueStatutDemande[]
  documentsTeleverses DemandeDocument[]
  paiement            Paiement?

  // Historique des corrections réalisées après le paiement initial.
  revisions RevisionDemande[]

  // Compléments éventuellement encaissés pour cette demande.
  paiementsComplementaires PaiementComplementaire[]

  // Dossier du service d'étude.
  // Seules les demandes d'INSCRIPTION validées et clôturées au guichet
  // pourront en posséder un.
  dossierEtude DossierEtude?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ancienne contrainte conservée temporairement.
  @@index([referenceFonciere])
  @@index([journalClotureId])
  @@index([cin])
  @@index([statutVerificationCni])
  @@index([nature])
  @@index([titreFoncierId])
  @@index([prestationId])
}

// ============================================================
// SERVICE D'ETUDE - SOCLE
// ============================================================

/**
 * Le dossier d'étude représente l'entrée d'une demande d'INSCRIPTION
 * dans le service d'étude.
 * Il est créé au moment de la distribution par le Responsable
 * des inscriptions, après validation et clôture au guichet.
 * Le résultat juridique n'est pas porté par ce dossier :
 * chaque opération foncière possède sa propre EtudeOperation.
 */
model DossierEtude {
  id String @id @default(uuid())

  // Une demande ne peut posséder qu'un seul dossier d'étude.
  demandeId String  @unique
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Restrict)

  statut StatutDossierEtude @default(EN_ETUDE)

  // Responsable des inscriptions ayant réalisé la distribution initiale.
  distribueParId String
  distribuePar   Utilisateur @relation("DossierEtudeDistribuePar", fields: [distribueParId], references: [id], onDelete: Restrict)

  dateDistribution DateTime @default(now())

  // Historique des affectations et réaffectations.
  affectations AffectationEtude[]

  // Une étude indépendante est créée pour chaque opération de la demande.
  etudesOperations EtudeOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([distribueParId])
  @@index([dateDistribution])
}

/**
 * Une affectation associe un dossier d'étude à un agent pour un rôle
 * métier donné : Rédacteur, Vérificateur ou Super-vérificateur.
 * Les anciennes affectations ne sont jamais supprimées :
 * une réaffectation clôt l'affectation précédente avec dateFin
 * puis crée une nouvelle affectation active.
 * Règle métier contrôlée côté service :
 * exactement une affectation active par type et par dossier.
 */
model AffectationEtude {
  id String @id @default(uuid())

  dossierEtudeId String
  dossierEtude   DossierEtude @relation(fields: [dossierEtudeId], references: [id], onDelete: Restrict)

  type TypeAffectationEtude

  // Agent affecté.
  utilisateurId String
  utilisateur   Utilisateur @relation("AffectationEtudeUtilisateur", fields: [utilisateurId], references: [id], onDelete: Restrict)

  // Responsable des inscriptions ayant effectué l'affectation.
  attribueParId String
  attribuePar   Utilisateur @relation("AffectationEtudeAttribuePar", fields: [attribueParId], references: [id], onDelete: Restrict)

  dateDebut DateTime  @default(now())
  dateFin   DateTime?

  // Renseigné notamment lors d'une réaffectation.
  motifReaffectation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossierEtudeId])
  @@index([dossierEtudeId, type])
  @@index([utilisateurId])
  @@index([utilisateurId, dateFin])
  @@index([attribueParId])
  @@index([dateDebut])
}

/**
 * Unité centrale du service d'étude.
 * Chaque opération foncière d'une demande est étudiée séparément et
 * ne peut posséder qu'une seule EtudeOperation.
 * Les avis, minutes, refus et décisions seront ajoutés dans les
 * migrations suivantes sans modifier la logique du guichet.
 */
model EtudeOperation {
  id String @id @default(uuid())

  dossierEtudeId String
  dossierEtude   DossierEtude @relation(fields: [dossierEtudeId], references: [id], onDelete: Restrict)

  // Relation 1 -> 0..1 avec l'opération existante de la demande.
  demandeOperationFonciereId String                   @unique
  demandeOperationFonciere   DemandeOperationFonciere @relation(fields: [demandeOperationFonciereId], references: [id], onDelete: Restrict)

  statut StatutEtudeOperation @default(EN_REDACTION)

  // Historique complet des avis du Rédacteur, du Vérificateur
  // et du Super-vérificateur.
  avis AvisEtude[] @relation("AvisEtudeOperation")

  // Avis retenu comme décision finale par le Super-vérificateur.
  // Il reste nul tant que l'opération n'est pas FINALISEE.
  avisFinalId String?    @unique
  avisFinal   AvisEtude? @relation("AvisFinalEtudeOperation", fields: [avisFinalId], references: [id], onDelete: Restrict)

  // Minute logique de l'opération en cas d'orientation INSCRIPTION.
  minuteInscription MinuteInscription?

  // Historique des retours pour correction.
  retoursCorrection RetourCorrection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dossierEtudeId])
  @@index([dossierEtudeId, statut])
  @@index([statut])
}

// ============================================================
// SERVICE D'ETUDE - TRAITEMENT ET VERSIONNEMENT
// ============================================================

/**
 * Un avis représente une prise de position métier à un instant donné.
 * Plusieurs avis peuvent être conservés pour un même niveau et une même
 * opération afin de préserver les cycles de correction et les divergences.
 * numeroAvis est incrémenté côté service pour chaque couple
 * (EtudeOperation, niveau).
 */
model AvisEtude {
  id String @id @default(uuid())

  etudeOperationId String
  etudeOperation   EtudeOperation @relation("AvisEtudeOperation", fields: [etudeOperationId], references: [id], onDelete: Restrict)

  niveau   NiveauAvisEtude
  decision DecisionAvisEtude

  numeroAvis Int

  // Snapshot métier du niveau ayant émis l'avis.
  // L'auteur reste également conservé même si son rôle change plus tard.
  auteurId String
  auteur   Utilisateur @relation("AvisEtudeAuteur", fields: [auteurId], references: [id], onDelete: Restrict)

  observations String? @db.Text

  // Un avis de REFUS peut porter un ou plusieurs motifs.
  motifsRefus MotifRefus[]

  // Retour(s) pour correction éventuellement déclenché(s) à partir de cet avis.
  retoursCorrectionDeclenches RetourCorrection[] @relation("RetourCorrectionAvisSource")

  // Relation inverse de EtudeOperation.avisFinal.
  // Au maximum une opération peut retenir cet avis comme avis final.
  decisionFinaleDe EtudeOperation? @relation("AvisFinalEtudeOperation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([etudeOperationId, niveau, numeroAvis])
  @@index([etudeOperationId])
  @@index([etudeOperationId, niveau])
  @@index([auteurId])
  @@index([decision])
  @@index([createdAt])
}

/**
 * Motif de refus rattaché à l'avis qui l'a produit.
 * Lorsqu'un avis est corrigé, l'ancien avis et ses anciens motifs restent
 * intacts : un nouvel AvisEtude est créé avec ses propres motifs.
 */
model MotifRefus {
  id String @id @default(uuid())

  avisEtudeId String
  avisEtude   AvisEtude @relation(fields: [avisEtudeId], references: [id], onDelete: Restrict)

  texte String @db.Text
  ordre Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([avisEtudeId, ordre])
  @@index([avisEtudeId])
}

/**
 * Minute logique d'une opération orientée vers l'INSCRIPTION.
 * Une opération possède au maximum une minute logique, mais cette minute
 * peut posséder autant de versions que nécessaire.
 * versionFinaleId reste nul pendant la rédaction/correction puis pointe
 * vers la version définitivement retenue.
 */
model MinuteInscription {
  id String @id @default(uuid())

  etudeOperationId String         @unique
  etudeOperation   EtudeOperation @relation(fields: [etudeOperationId], references: [id], onDelete: Restrict)

  modePreparation ModePreparationMinute
  referenceModele String?

  versions VersionMinute[] @relation("VersionsMinuteInscription")

  versionFinaleId String?        @unique
  versionFinale   VersionMinute? @relation("VersionFinaleMinute", fields: [versionFinaleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modePreparation])
}

/**
 * Version immuable du contenu d'une minute.
 * Une modification ne remplace jamais une ancienne version : elle crée
 * une nouvelle VersionMinute avec un numéro supérieur.
 * niveauAuteur mémorise le niveau métier au moment de la rédaction afin
 * de permettre notamment une modification finale par le Super-vérificateur.
 */
model VersionMinute {
  id String @id @default(uuid())

  minuteInscriptionId String
  minuteInscription   MinuteInscription @relation("VersionsMinuteInscription", fields: [minuteInscriptionId], references: [id], onDelete: Restrict)

  numeroVersion Int

  contenu String @db.Text

  auteurId String
  auteur   Utilisateur @relation("VersionMinuteAuteur", fields: [auteurId], references: [id], onDelete: Restrict)

  niveauAuteur NiveauAvisEtude

  // Relation inverse de MinuteInscription.versionFinale.
  minuteFinaleDe MinuteInscription? @relation("VersionFinaleMinute")

  createdAt DateTime @default(now())

  @@unique([minuteInscriptionId, numeroVersion])
  @@index([minuteInscriptionId])
  @@index([auteurId])
  @@index([createdAt])
}

/**
 * Trace d'un renvoi pour correction entre deux niveaux du circuit.
 * Chaînes autorisées fonctionnellement :
 * - VERIFICATEUR -> REDACTEUR
 * - SUPER_VERIFICATEUR -> VERIFICATEUR
 * - VERIFICATEUR -> REDACTEUR après un retour du Super-vérificateur
 * Ces règles sont contrôlées par le service backend.
 */
model RetourCorrection {
  id String @id @default(uuid())

  etudeOperationId String
  etudeOperation   EtudeOperation @relation(fields: [etudeOperationId], references: [id], onDelete: Restrict)

  deNiveau   NiveauAvisEtude
  versNiveau NiveauAvisEtude

  auteurId String
  auteur   Utilisateur @relation("RetourCorrectionAuteur", fields: [auteurId], references: [id], onDelete: Restrict)

  destinataireId String
  destinataire   Utilisateur @relation("RetourCorrectionDestinataire", fields: [destinataireId], references: [id], onDelete: Restrict)

  // Facultatif : avis ayant directement conduit au retour.
  avisSourceId String?
  avisSource   AvisEtude? @relation("RetourCorrectionAvisSource", fields: [avisSourceId], references: [id], onDelete: Restrict)

  motif String @db.Text

  dateRetour     DateTime  @default(now())
  dateTraitement DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etudeOperationId])
  @@index([auteurId])
  @@index([destinataireId])
  @@index([avisSourceId])
  @@index([dateRetour])
  @@index([dateTraitement])
}

// ============================================================
// TARIFICATION CALCULEE D'UNE DEMANDE
// ============================================================

model TarificationDemande {
  id String @id @default(uuid())

  demandeId String  @unique
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  // Snapshot de la nature de la demande.
  nature NatureDemande

  // Snapshot éventuel de la prestation.
  prestationCode    String?
  prestationLibelle String?

  langue      LangueCertificat?
  nombrePages Int?

  montantTotal Decimal @db.Decimal(10, 3)

  referenceReglementaire String?

  statut StatutTarification @default(CALCULEE)

  dateCalcul  DateTime  @default(now())
  dateFigeage DateTime?

  lignes LigneTarification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([dateCalcul])
}

// ============================================================
// LIGNES DE TARIFICATION
// ============================================================

model LigneTarification {
  id String @id @default(uuid())

  tarificationId String
  tarification   TarificationDemande @relation(fields: [tarificationId], references: [id], onDelete: Cascade)

  type TypeLigneTarification

  code String?

  libelle String

  quantite Int @default(1)

  montantUnitaire Decimal @db.Decimal(10, 3)
  montant         Decimal @db.Decimal(10, 3)

  ordre Int @default(0)

  createdAt DateTime @default(now())

  @@index([tarificationId])
  @@index([type])
}

// ============================================================
// REVISIONS EFFECTUEES PAR LE RESPONSABLE GUICHET
// ============================================================

/**
 * Une révision représente une correction effectuée par le
 * Responsable Guichet après le paiement initial.
 * Le snapshot tarifaire initial reste FIGE et n'est jamais
 * écrasé. La révision conserve donc :
 * - les données avant/après correction ;
 * - le montant avant/après recalcul ;
 * - le complément éventuel ;
 * - les lignes du nouveau calcul tarifaire.
 */
model RevisionDemande {
  id String @id @default(uuid())

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  // Numéro séquentiel propre à la demande : 1, 2, 3...
  numeroRevision Int

  responsableId String
  responsable   Utilisateur @relation("RevisionDemandeResponsable", fields: [responsableId], references: [id], onDelete: Restrict)

  // Snapshot des informations métier avant et après correction.
  donneesAvant Json
  donneesApres Json

  // Justification ou commentaire de la correction.
  motif String?

  // Tarification de référence avant et après la correction.
  montantAvant Decimal @db.Decimal(10, 3)
  montantApres Decimal @db.Decimal(10, 3)

  // Toujours >= 0. Une baisse tarifaire sera bloquée côté service
  // tant qu'aucune règle métier de remboursement n'est définie.
  complementDu Decimal @default(0.000) @db.Decimal(10, 3)

  referenceReglementaire String?

  statut StatutRevisionDemande @default(SANS_COMPLEMENT)

  lignes LigneRevisionTarification[]

  paiementComplementaire PaiementComplementaire?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandeId, numeroRevision])
  @@index([demandeId])
  @@index([responsableId])
  @@index([statut])
  @@index([createdAt])
}

// ============================================================
// LIGNES DE TARIFICATION D'UNE REVISION
// ============================================================

model LigneRevisionTarification {
  id String @id @default(uuid())

  revisionId String
  revision   RevisionDemande @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  type TypeLigneTarification

  code     String?
  libelle  String
  quantite Int     @default(1)

  montantUnitaire Decimal @db.Decimal(10, 3)
  montant         Decimal @db.Decimal(10, 3)

  ordre Int @default(0)

  createdAt DateTime @default(now())

  @@index([revisionId])
  @@index([type])
}

// ============================================================
// PAIEMENT COMPLEMENTAIRE
// ============================================================

/**
 * Un complément est un encaissement distinct du paiement initial.
 * Le paiement initial reste donc inchangé et conserve son reçu.
 */
model PaiementComplementaire {
  id         String @id @default(uuid())
  numeroRecu String @unique

  montantExigible Decimal @db.Decimal(10, 3)
  montantRemis    Decimal @db.Decimal(10, 3)
  monnaieRendue   Decimal @default(0.000) @db.Decimal(10, 3)
  montantEncaisse Decimal @db.Decimal(10, 3)

  modePaiement ModePaiement   @default(ESPECES)
  statut       StatutPaiement @default(PAYE)

  montantEnLettres String?
  observations     String?
  datePaiement     DateTime @default(now())

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Restrict)

  // Une révision tarifaire ne peut être réglée qu'une seule fois.
  revisionId String          @unique
  revision   RevisionDemande @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  caissierId String
  caissier   Utilisateur @relation("PaiementComplementaireCaissier", fields: [caissierId], references: [id], onDelete: Restrict)

  journalCaisseId String?
  journalCaisse   JournalCaisse? @relation(fields: [journalCaisseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandeId])
  @@index([caissierId])
  @@index([journalCaisseId])
  @@index([datePaiement])
}

// ============================================================
// HISTORIQUE DES STATUTS
// ============================================================

model HistoriqueStatutDemande {
  id            String        @id @default(uuid())
  ancienStatut  StatutDemande
  nouveauStatut StatutDemande
  motif         String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  createdAt DateTime @default(now())

  @@index([demandeId])
  @@index([utilisateurId])
}

// ============================================================
// DOCUMENTS
// ============================================================

model DemandeDocument {
  id String @id @default(uuid())

  type TypeDocument

  nomOriginal   String
  nomStockage   String @unique
  cheminFichier String
  mimeType      String
  taille        Int

  statut             StatutDocument @default(DEPOSE)
  motifNonConformite String?

  demandeId String
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandeId, type])
  @@index([demandeId])
  @@index([utilisateurId])
}

// ============================================================
// JOURNAL DE CLOTURE
// ============================================================

model JournalCloture {
  id     String @id @default(uuid())
  numero String @unique

  dateJour DateTime @unique @db.Date

  // Date de la clôture actuellement active.
  // Lors d'une éventuelle reclôture le même jour, cette date sera actualisée.
  // L'historique complet reste conservé dans JournalClotureEvenement.
  dateCloture DateTime @default(now())

  statut StatutJournalCloture @default(CLOTURE)

  observations String?

  responsableId String
  responsable   Utilisateur @relation(fields: [responsableId], references: [id])

  demandes Demande[]

  // Historique immuable des clôtures et déclôtures.
  evenements JournalClotureEvenement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsableId])
  @@index([statut])
}

model JournalClotureEvenement {
  id String @id @default(uuid())

  journalClotureId String
  journalCloture   JournalCloture @relation(fields: [journalClotureId], references: [id], onDelete: Restrict)

  type TypeEvenementJournalCloture

  // Auteur de l'événement : Responsable/Admin pour une clôture,
  // ADMIN uniquement pour une déclôture.
  auteurId String
  auteur   Utilisateur @relation("JournalClotureEvenementAuteur", fields: [auteurId], references: [id], onDelete: Restrict)

  // Obligatoire fonctionnellement pour une déclôture.
  // Le contrôle sera assuré par le service backend.
  motif String?

  dateEvenement DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([journalClotureId])
  @@index([auteurId])
  @@index([type])
  @@index([dateEvenement])
}

// ============================================================
// JOURNAL DE CAISSE
// ============================================================

model JournalCaisse {
  id     String @id @default(uuid())
  numero String @unique

  dateJour DateTime @db.Date

  statut StatutJournalCaisse @default(OUVERT)

  dateCloture DateTime?

  observations String?

  caissierId String
  caissier   Utilisateur @relation("JournalCaisseCaissier", fields: [caissierId], references: [id], onDelete: Restrict)

  paiements Paiement[]

  // Encaissements complémentaires liés aux corrections du Responsable.
  paiementsComplementaires PaiementComplementaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caissierId, dateJour])
  @@index([caissierId])
  @@index([dateJour])
  @@index([statut])
}

// ============================================================
// PAIEMENTS
// ============================================================

model Paiement {
  id         String @id @default(uuid())
  numeroRecu String @unique

  montantExigible Decimal @db.Decimal(10, 3)

  montantRemis Decimal @db.Decimal(10, 3)

  monnaieRendue Decimal @default(0.000) @db.Decimal(10, 3)

  montantEncaisse Decimal @db.Decimal(10, 3)

  modePaiement ModePaiement   @default(ESPECES)
  statut       StatutPaiement @default(PAYE)

  montantEnLettres String?
  observations     String?

  datePaiement DateTime @default(now())

  demandeId String  @unique
  demande   Demande @relation(fields: [demandeId], references: [id], onDelete: Restrict)

  caissierId String
  caissier   Utilisateur @relation(fields: [caissierId], references: [id], onDelete: Restrict)

  journalCaisseId String?
  journalCaisse   JournalCaisse? @relation(fields: [journalCaisseId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caissierId])
  @@index([journalCaisseId])
  @@index([datePaiement])
}
